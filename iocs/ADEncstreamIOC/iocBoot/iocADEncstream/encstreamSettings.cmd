# encstreamSettings.cmd - settings after iocInit that a site would keep with autosave

# ROIStat: its array output off (it would forward a copy of the main array); ROI n is
# row n-1 of the main array, the whole frame (but see R3: the size shrinks with short frames)
dbpf("$(PREFIX)$(ROISTAT_PREFIX):ArrayCallbacks", "0")
dbpf("$(PREFIX)$(ROISTAT_PREFIX):1:Use", "1")
dbpf("$(PREFIX)$(ROISTAT_PREFIX):1:MinX", "0")
dbpf("$(PREFIX)$(ROISTAT_PREFIX):1:SizeX", "1")
dbpf("$(PREFIX)$(ROISTAT_PREFIX):1:SizeY", "$(MAX_SAMPLES)")
dbpf("$(PREFIX)$(ROISTAT_PREFIX):1:Name", "Motor[1]")
