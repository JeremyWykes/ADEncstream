# ADEncstreamAxis.template - one motor's records, address n-1 for Motor[n] (macro NAME: a human name).
#
# Macros: P, R (record prefix), PORT (the ADEncstream port), ADDR, TIMEOUT.
# Record meanings: the ADEncstream guide The parameter names are those of ADEncstream.h;
# keep the two in step.

record(ai, "$(P)$(R)Mean_RBV")
{
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))ES_MEAN")
    field(SCAN, "I/O Intr")
    field(PREC, "6")
}

