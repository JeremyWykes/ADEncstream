# ADEncstream.template - driver-level records, address 0 (with NDArrayBase.template at the same prefix).
#
# Macros: P, R (record prefix), PORT (the ADEncstream port), ADDR, TIMEOUT.
# Record meanings: the ADEncstream guide The parameter names are those of ADEncstream.h;
# keep the two in step.

# ---- stream (receiver) ----

record(lsi, "$(P)$(R)BrickAddress_RBV")
{
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))ES_BRICK_ADDRESS")
    field(SCAN, "I/O Intr")
    field(SIZV, "128")
}

