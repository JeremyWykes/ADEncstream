# ADEncstreamArray.template - read-only array diagnostics of one NDArray address.
#
# Macros: P, R (record prefix), PORT (the ADEncstream port), ADDR, TIMEOUT.
# Record meanings: the ADEncstream guide The parameter names are those of ADEncstream.h;
# keep the two in step.

record(longin, "$(P)$(R)ArrayCounter_RBV")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))ARRAY_COUNTER")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)$(R)ArraySizeX_RBV")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))ARRAY_SIZE_X")
    field(SCAN, "I/O Intr")
}

