10 00                    # row size 16
01 00 00 00              # calibration generation 1
01 00 00 00              # flags: bit 0 rows skipped
07 00 00 00              # rows skipped 7
# row 0
04 03 02 01              # ServoCount 0x01020304
A5 08 A5 A5              # gate word 0xA5A508A5
00 00 00 00 00 E0 5E 40  # 123.5 (low word first)
